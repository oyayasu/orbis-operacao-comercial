{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbis - Operação Comercial",
  "version": "0.1.1",
  "identifier": "com.orbis.operacaocomercial",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orbis | Operação Comercial",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#f4f6f9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
